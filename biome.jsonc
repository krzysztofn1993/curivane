{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"files": {
		// context/ is the 10x bootstrap chain's docs folder — never lint or format it.
		"includes": ["**", "!context"]
	},
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended",
			"source": {
				"preset": "recommended",
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				// Raw `db` stays behind src/server/data (forUser), which scopes queries to the owner.
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/db", "**/db/index", "**/db/index.*"],
								"message": "Nie importuj instancji db poza modułem danych. Użyj ~/server/data (forUser), patrz AGENTS.md."
							}
						]
					}
				}
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"overrides": [
		{
			// The only places allowed to import the db instance directly.
			"includes": [
				"src/server/db/**",
				"src/server/auth/**",
				"src/app/(auth)/actions.ts",
				"src/server/data/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	],
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"tailwind": { "mergeFunctions": ["clsx", "cn"], "variantFunctions": ["cva"] }
}
